# --- Server ---
PORT=3000

# development|production
ENV=development

# --- Postgres (with pgvector extension enabled) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=plaud
DB_PASSWORD=plaud
DB_NAME=plaud

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxx

# --- Field encryption (AES-256-GCM) ---
# Encrypts fullText and summaries columns at the application layer before writing to DB.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable (development only — do NOT deploy to production without this).
ENCRYPTION_KEY=

# --- IoT device auth ---
# HMAC secret shared with provisioned devices, used to validate X-Device-Signature
DEVICE_HMAC_SECRET=super-secret-device-key
# Max allowed clock skew (seconds) between device timestamp and server time
DEVICE_SIGNATURE_TTL_SECONDS=300

# --- Telegram channel (alternative inbound adapter to the physical device) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Arbitrary secret you choose; passed to setWebhook and echoed back by Telegram
# in the X-Telegram-Bot-Api-Secret-Token header on every webhook call.
TELEGRAM_WEBHOOK_SECRET=super-secret-webhook-token

# --- Google Calendar (optional) ---
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: https://<your-domain>/auth/google/callback
# Required scope: https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# --- Billing adapter ---
# 'mock' (default, counts nothing) or 'real' (deducts minutes from user balance)
BILLING_DRIVER=mock

# --- Payment gate (optional) ---
# Set PAYMENT_REQUIRED=true to block new/unknown users until they pay.
# New devices that connect for the first time will receive a paymentUrl error
# and the WebSocket connection is closed. Existing users (already in DB) pass through.
PAYMENT_REQUIRED=false
PAYMENT_URL=https://your-payment-page.example.com/subscribe
# How many recordings are free before payment is required (0 = unlimited)
FREE_TRACKS_LIMIT=10

# --- Storage ---
# 'local' writes to disk (fine for a demo, NOT for production volume).
# 's3' uploads to AWS S3 and hands back a presigned URL instead.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000

# --- AWS S3 (only used when STORAGE_DRIVER=s3) ---
AWS_REGION=eu-central-1
S3_BUCKET_NAME=plaud-recordings
S3_PRESIGNED_URL_TTL_SECONDS=86400
# How long a device has to actually PUT bytes after requesting an upload URL
S3_PRESIGNED_UPLOAD_URL_TTL_SECONDS=900
# Optional: only needed outside AWS (e.g. running locally against a real bucket).
# On EC2/ECS/Lambda, omit these and let the SDK use the instance/task IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Live assistant (Galaxy Watch "answer mode", WS /assist/live) ---
# Ground real-time answers in the user's own memory (adds one embedding + pgvector query per answer).
ASSISTANT_MEMORY_LOOKUP=true
# Realtime model for splitting speech into utterances (needs server VAD support; gpt-realtime-whisper has none)
REALTIME_VAD_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Hint for that model (vocabulary, languages). Keeps English terms in Latin script inside Russian/Ukrainian speech.
# REALTIME_TRANSCRIPTION_PROMPT=Mixed Russian, Ukrainian and English speech. Write English words and brand names in Latin script.
# Assistant web search (prices, news, weather). Model searches only when needed; each search is billed.
ASSISTANT_WEB_SEARCH=true
# Country for local search results (currency, shops), ISO code, e.g. UA
ASSISTANT_SEARCH_COUNTRY=
# Assistant voice generated on the server (natural, handles mixed languages) and streamed to the watch.
ASSISTANT_SERVER_TTS=true
ASSISTANT_TTS_MODEL=gpt-4o-mini-tts
# alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse
ASSISTANT_TTS_VOICE=alloy
# DEV ONLY: log heard text and answers to diagnose assistant behaviour (private content!)
# ASSISTANT_DEBUG_LOG_TEXT=true
# Model for live assistant answers (default gpt-4o-mini: cheapest/fastest, weakest on tricky questions)
# ASSISTANT_MODEL=gpt-4.1-mini
