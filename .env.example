# --- Server ---
PORT=3000

# development|production
ENV=development

# --- Postgres (with pgvector extension enabled) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=plaud
DB_PASSWORD=plaud
DB_NAME=plaud

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxx

# --- IoT device auth ---
# HMAC secret shared with provisioned devices, used to validate X-Device-Signature
DEVICE_HMAC_SECRET=super-secret-device-key
# Max allowed clock skew (seconds) between device timestamp and server time
DEVICE_SIGNATURE_TTL_SECONDS=300

# --- Telegram channel (alternative inbound adapter to the physical device) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Arbitrary secret you choose; passed to setWebhook and echoed back by Telegram
# in the X-Telegram-Bot-Api-Secret-Token header on every webhook call.
TELEGRAM_WEBHOOK_SECRET=super-secret-webhook-token

# --- Billing adapter ---
# 'mock' (default, counts nothing) or 'real' (deducts minutes from user balance)
BILLING_DRIVER=mock

# --- Payment gate (optional) ---
# Set PAYMENT_REQUIRED=true to block new/unknown users until they pay.
# New devices that connect for the first time will receive a paymentUrl error
# and the WebSocket connection is closed. Existing users (already in DB) pass through.
PAYMENT_REQUIRED=false
PAYMENT_URL=https://your-payment-page.example.com/subscribe
# How many recordings are free before payment is required (0 = unlimited)
FREE_TRACKS_LIMIT=10

# --- Storage ---
# 'local' writes to disk (fine for a demo, NOT for production volume).
# 's3' uploads to AWS S3 and hands back a presigned URL instead.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000

# --- AWS S3 (only used when STORAGE_DRIVER=s3) ---
AWS_REGION=eu-central-1
S3_BUCKET_NAME=plaud-recordings
S3_PRESIGNED_URL_TTL_SECONDS=86400
# How long a device has to actually PUT bytes after requesting an upload URL
S3_PRESIGNED_UPLOAD_URL_TTL_SECONDS=900
# Optional: only needed outside AWS (e.g. running locally against a real bucket).
# On EC2/ECS/Lambda, omit these and let the SDK use the instance/task IAM role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
